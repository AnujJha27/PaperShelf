{
  "name": "paper-radar",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "workspaces": [
    "apps/web",
    "workers/gateway",
    "packages/shared"
  ],
  "scripts": {
    "test": "pnpm test:js && pnpm test:python && pnpm test:extraction",
    "test:js": "pnpm --recursive --if-present test",
    "test:python": "cd services/recommender && uv sync --locked --no-install-project && uv run --locked --no-sync pytest -q",
    "test:extraction": "cd services/extraction && uv run --locked pytest -q",
    "lint": "eslint . && pnpm --recursive --if-present typecheck",
    "build": "pnpm --recursive --if-present build",
    "test:web": "pnpm --filter @paper-radar/web test",
    "test:worker": "pnpm --filter @paper-radar/gateway test",
    "test:e2e": "pnpm --filter @paper-radar/web exec playwright test --config ../../playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.3.0",
    "eslint": "^9.39.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.4"
  }
}
